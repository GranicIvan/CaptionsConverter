<UserControl x:Class="CaptionsConverter.GUI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CaptionsConverter.GUI.Views"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="540">

    <UserControl.Resources>
        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#667eea" Offset="0"/>
            <GradientStop Color="#764ba2" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrimaryGradientHover" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#7c8ef0" Offset="0"/>
            <GradientStop Color="#8a5bb5" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#11998e" Offset="0"/>
            <GradientStop Color="#38ef7d" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SuccessGradientHover" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#13b29e" Offset="0"/>
            <GradientStop Color="#45f98e" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SecondaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#434343" Offset="0"/>
            <GradientStop Color="#000000" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="BackgroundGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#f5f7fa" Offset="0"/>
            <GradientStop Color="#c3cfe2" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#667eea" Offset="0"/>
            <GradientStop Color="#6b7bee" Offset="0.25"/>
            <GradientStop Color="#7162eb" Offset="0.5"/>
            <GradientStop Color="#7662d8" Offset="0.6"/>
            <GradientStop Color="#764ba2" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" 
                                                  ShadowDepth="3" 
                                                  Opacity="0.3" 
                                                  Color="#667eea"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryGradientHover}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource SecondaryGradient}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" 
                                                  ShadowDepth="3" 
                                                  Opacity="0.2" 
                                                  Color="#000000"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource SuccessGradient}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" 
                                                  ShadowDepth="4" 
                                                  Opacity="0.4" 
                                                  Color="#11998e"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SuccessGradientHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="White" Opacity="0.95"/>
                </Setter.Value>
            </Setter>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20" 
                                      ShadowDepth="5" 
                                      Opacity="0.15" 
                                      Color="#667eea"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.Background>
            <StaticResource ResourceKey="BackgroundGradient"/>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" 
                Background="{StaticResource HeaderGradient}" 
                Padding="24"
                CornerRadius="0,0,20,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" 
                                  ShadowDepth="5" 
                                  Opacity="0.3" 
                                  Color="#667eea"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Settings" 
                           FontSize="36" 
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="8" 
                                          ShadowDepth="2" 
                                          Opacity="0.5" 
                                          Color="#000000"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="Configure application preferences" 
                           FontSize="15" 
                           Foreground="#f0f0f0"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="30">
            <StackPanel MaxWidth="700">

                <Border Style="{StaticResource GlassCard}"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Language Mappings" 
                                   FontSize="20" 
                                   FontWeight="Bold"
                                   Foreground="#667eea"
                                   Margin="0,0,0,16"/>

                        <TextBlock Text="Select which language character mappings to use during conversion. Multiple languages can be enabled simultaneously."
                                   FontSize="13"
                                   Foreground="#6c757d"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>

                        <Border Background="#f8f9fa"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Current Status:" 
                                           FontSize="13" 
                                           FontWeight="SemiBold"
                                           Foreground="#495057"
                                           Margin="0,0,0,4"/>
                                <TextBlock x:Name="ActiveLanguagesText"
                                           Text="Loading..."
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           FontWeight="Medium"/>
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="LanguageListPanel" Margin="0,0,0,12">
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Center">
                            <Button Content="Enable All"
                                    Click="EnableAll_Click"
                                    Style="{StaticResource ModernButton}"
                                    Margin="0,0,10,0"
                                    Padding="16,8"/>
                            <Button Content="Disable All"
                                    Click="DisableAll_Click"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="16,8"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GlassCard}"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="File Handling" 
                                   FontSize="20" 
                                   FontWeight="Bold"
                                   Foreground="#667eea"
                                   Margin="0,0,0,16"/>

                        <CheckBox x:Name="AutoOpenFolderCheckBox"
                                  Content="Auto-open output folder after conversion"
                                  FontSize="14"
                                  Margin="0,0,0,12"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GlassCard}"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Conversion Options" 
                                   FontSize="20" 
                                   FontWeight="Bold"
                                   Foreground="#667eea"
                                   Margin="0,0,0,16"/>

                        <CheckBox x:Name="ConfirmBeforeConversionCheckBox"
                                  Content="Confirm before converting files"
                                  FontSize="14"
                                  IsChecked="True"
                                  Margin="0,0,0,12"/>

                        <CheckBox x:Name="ShowDetailedLogsCheckBox"
                                  Content="Show detailed conversion logs"
                                  FontSize="14"
                                  IsEnabled="False"
                                  Margin="0,0,0,12"
                                  ToolTip="Feature coming soon"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GlassCard}">
                    <StackPanel>
                        <Button Content="Save All Settings"
                                Click="SaveSettings_Click"
                                Style="{StaticResource SuccessButton}"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,12"
                                Height="48"/>

                        <Button Content="Back to Menu" 
                                Click="Back_Click" 
                                Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
